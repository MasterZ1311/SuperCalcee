    "desc": "Q_be = Fixed_Costs / (Price - Variable_Cost)",
    "expression": "Fixed_Costs / (Price - Variable_Cost)",
    "variables": [
      "Fixed_Costs",
      "Price",
      "Variable_Cost"
    ],
    "unit": "units"
  },
  {
    "id": "corp_breakeven_revenue",
