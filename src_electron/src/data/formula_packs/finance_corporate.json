    "variables": [
      "Fixed_Costs",
      "CMR"
    ],
    "unit": "$"
  },
  {
    "id": "corp_cmr",
    "name": "Contribution Margin Ratio",
    "desc": "CMR = (Price - Variable_Cost) / Price",
    "expression": "(Price - Variable_Cost) / Price",
    "variables": [
      "Price",
      "Variable_Cost"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_margin_of_safety",
