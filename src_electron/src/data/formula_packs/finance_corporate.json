[
  {
    "id": "corp_wacc",
    "name": "Weighted Average Cost of Capital",
    "desc": "WACC = (E/V)*Re + (D/V)*Rd*(1 - Tc)",
    "expression": "(E / V) * Re + (D / V) * Rd * (1 - Tc)",
    "variables": [
      "E",
      "D",
      "V",
      "Re",
      "Rd",
      "Tc"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_capm_cost_equity",
    "name": "CAPM Cost of Equity",
    "desc": "Re = Rf + beta * (Rm - Rf)",
    "expression": "Rf + beta * (Rm - Rf)",
    "variables": [
      "Rf",
      "beta",
      "Rm"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_cost_preferred",
    "name": "Cost of Preferred Stock",
    "desc": "Rp = Dp / Pp",
    "expression": "Dp / Pp",
    "variables": [
      "Dp",
      "Pp"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_gordon_equity_cost",
    "name": "Gordon Growth Cost of Equity",
    "desc": "Re = (D1 / P0) + g",
    "expression": "(D1 / P0) + g",
    "variables": [
      "D1",
      "P0",
      "g"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_npv_uniform",
    "name": "Net Present Value Uniform Inflows",
    "desc": "NPV = CF * ((1 - (1 + r)^(-n)) / r) - C0",
    "expression": "CF * ((1 - (1 + r)^(-n)) / r) - C0",
    "variables": [
      "CF",
      "r",
      "n",
      "C0"
    ],
    "unit": "$"
  },
  {
    "id": "corp_profitability_index",
    "name": "Profitability Index (Benefit/Cost)",
    "desc": "PI = PV_inflows / C0",
    "expression": "PV_inflows / C0",
    "variables": [
      "PV_inflows",
      "C0"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_simple_payback",
    "name": "Simple Payback Period",
    "desc": "Years = Initial_Cost / Annual_Cash_Flow",
    "expression": "Initial_Cost / Annual_Cash_Flow",
    "variables": [
      "Initial_Cost",
      "Annual_Cash_Flow"
    ],
    "unit": "years"
  },
  {
    "id": "corp_fcff",
    "name": "Free Cash Flow to Firm (FCFF)",
    "desc": "FCFF = EBIT*(1 - t) + Dep - CapEx - dNWC",
    "expression": "EBIT * (1 - t) + Dep - CapEx - dNWC",
    "variables": [
      "EBIT",
      "t",
      "Dep",
      "CapEx",
      "dNWC"
    ],
    "unit": "$"
  },
  {
    "id": "corp_fcfe",
    "name": "Free Cash Flow to Equity (FCFE)",
    "desc": "FCFE = NI + Dep - CapEx - dNWC + NetBorrowing",
    "expression": "NI + Dep - CapEx - dNWC + NetBorrowing",
    "variables": [
      "NI",
      "Dep",
      "CapEx",
      "dNWC",
      "NetBorrowing"
    ],
    "unit": "$"
  },
  {
    "id": "corp_ebitda",
    "name": "EBITDA Operating Earnings",
    "desc": "EBITDA = EBIT + Dep + Amort",
    "expression": "EBIT + Dep + Amort",
    "variables": [
      "EBIT",
      "Dep",
      "Amort"
    ],
    "unit": "$"
  },
  {
    "id": "corp_dol",
    "name": "Degree of Operating Leverage",
    "desc": "DOL = (Q * (P - V)) / (Q * (P - V) - F)",
    "expression": "(Q * (P - V)) / (Q * (P - V) - F)",
    "variables": [
      "Q",
      "P",
      "V",
      "F"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_dfl",
    "name": "Degree of Financial Leverage",
    "desc": "DFL = EBIT / (EBIT - Interest)",
    "expression": "EBIT / (EBIT - Interest)",
    "variables": [
      "EBIT",
      "Interest"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_dcl",
    "name": "Degree of Combined Leverage",
    "desc": "DCL = DOL * DFL",
    "expression": "DOL * DFL",
    "variables": [
      "DOL",
      "DFL"
    ],
    "unit": "ratio"
  },
  {
    "id": "corp_breakeven_units",
