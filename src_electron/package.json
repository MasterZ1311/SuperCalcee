{
  "name": "src_electron",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop Multi-Domain Scientific Calculator and Computer Algebra System",
  "author": "SuperCalcee Open Source Team",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "package": "vite build && electron-builder --dir",
    "test": "node --test test/**/*.test.js"
  },
  "build": {
    "appId": "com.supercalcee.app",
    "productName": "SuperCalcee",
    "electronVersion": "41.10.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "src/security/**/*",
      "src/main/**/*"
    ],
    "extraResources": [
      {
        "from": "../venv",
        "to": "venv",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../src_python",
        "to": "src_python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": "zip"
    }
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "supercalcee": "file:.."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "brace-expansion": "^1.1.18"
  }
}
